OPENAI_API_KEY=
# Required, and deliberately has no default: choose a model available to your account.
# Verify it from the Administration > AI service tab (calls the models endpoint).
OPENAI_MODEL=gpt-4o-mini
# Optional: enables embeddings for semantic document retrieval (keyword retrieval works without it).
OPENAI_EMBEDDING_MODEL=
# Milliseconds
OPENAI_TIMEOUT=60000
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=3000
# Set to true when using a reasoning model (requests are stateless, so reasoning state is replayed).
OPENAI_INCLUDE_ENCRYPTED_REASONING=false
# Optional cost estimate shown per answer: USD per 1M tokens, copied from your price list.
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=
# Optional gateway/base URL (leave empty for api.openai.com)
OPENAI_BASE_URL=
TATTVA_MAX_TOOL_ROUNDS=8

# Sign-in. Production requires both; the demo passphrase is only for the demo identity provider.
SESSION_SECRET=
DEMO_LOGIN_PASSWORD=
# Comma-separated extra origins allowed to make state-changing requests
PROCUREMENT_ALLOWED_ORIGINS=
# Set to /tender when the AdvaitSI site mounts this app beneath that path (its dev server proxies /tender here). Leave empty to run standalone at /.
NEXT_PUBLIC_BASE_PATH=

# Data. Defaults to ../ADVAITSI_GEM_SYNTHETIC_PROCUREMENT
PROCUREMENT_DATA_DIR=
PROCUREMENT_DOCUMENTS_DIR=
# The demo's "today" (YYYY-MM-DD). Defaults to as_of_date in generation_config.yaml
PROCUREMENT_AS_OF=
# Writable application state (sessions, conversations, audit log). Default .data/tender-intelligence.db
ADVAIT_APP_DB=
# Document index built by `npm run ingest:docs`. Default .data/documents.db
PROCUREMENT_DOCS_DB=
